# کلید را اینجا نگذارید. مقدار واقعی فقط در محیط اجرا یا فایل محلی .env می‌ماند.

# کلاینت سازگار با OpenAI (chat completions + tool calling)
BOXAPI_API_KEY=
BOXAPI_BASE_URL=
BOXAPI_MODEL=

# فایل SQLite که scripts/build_db.py می‌سازد
DATABASE_PATH=./data/starcoach.db

# مبدأهای مجاز مرورگر. برای دموی محلی * کافی است.
CORS_ORIGINS=*

# قیمتی که آخرین تغییرش از این تعداد روز قدیمی‌تر باشد، کهنه حساب می‌شود.
STALE_PRICE_DAYS=30

# فقط برای اسکریپت ساخت پایگاه. آدرس داده؛ خودِ داده commit نمی‌شود.
DATASET_URL=https://startech.s3.ir-central1.arvanstorage.ir/starcoach-dataset-v16-cap300-csv.zip
DATA_DIR=./data
