# copy to .env (never commit it). Names only - fill values locally / in Liara "Environment variables".
BOXAPI_API_KEY=
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_NATIVE_URL=https://api.avalai.ir/v1beta
PLAYGROUND_TOKEN=
PLAYGROUND_SPEND_CAP=0.50
DATA_DIR=/data
TOROB_DB_PATH=/data/torob.sqlite
# optional: pre-signed URL (.sqlite or .sqlite.gz) to fetch the DB on first boot
TOROB_DB_URL=
TRYON_MODEL=gemini-2.5-flash-image
TRYON_API=native
TRYON_CAP_USD=2.0
TRYON_PER_SESSION=3
MALLGUIDE_CAP_USD=0.10
PORT=8000
