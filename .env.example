# Do not put a real key here. Set BOXAPI_API_KEY only in the runtime environment.

# OpenAI-compatible chat completions. gpt-6-luna rejects max_tokens;
# the agent sends max_completion_tokens and reasoning_effort=none.
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_MODEL=gpt-6-luna

# SQLite file produced by scripts/build_db.py. Never commit it.
DATABASE_PATH=./data/torob.sqlite
DATA_DIR=./data

# Browser origins. * is enough for a local demo.
CORS_ORIGINS=*

# Embeddings (optional, recall fallback): text-embedding-3-small, 256 dimensions.
# Generate once with scripts/embed_products.py. The .npy cache is gitignored.

# Dataset URL used by scripts/build_db.py. The zip itself is not committed.
DATASET_URL=https://startech.s3.ir-central1.arvanstorage.ir/starcoach-dataset-v16-cap300-csv.zip

# Recall layer. Default on. Set TOROB_RECALL=0 for the lexical baseline.
# TOROB_ALIAS=1 TOROB_LLM_EXPAND=1 TOROB_EMBED=1 TOROB_GRADER=1
